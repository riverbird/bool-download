<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoolDownload.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="BoolDownload.Views.AcceleratorDialog"
        x:DataType="vm:AcceleratorViewModel"
        Title="文件加速"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Design.DataContext>
        <vm:AcceleratorViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="14">
            <!-- 加速类型 -->
            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                <TextBlock Text="加速类型" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AccelTypes}"
                          SelectedItem="{Binding SelectedType}"
                          HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 下载链接输入框 -->
            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                <TextBlock Text="下载链接" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding InputUrl}"
                         PlaceholderText="输入下载链接，例如：https://github.com/user/repo/releases/download/..." />
            </Grid>

            <!-- 转换链接按钮 -->
            <Button Command="{Binding ConvertCommand}" HorizontalAlignment="Left" Padding="16,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="转换链接" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 下载链接列表 -->
            <TextBlock Text="下载链接"
                       FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding Nodes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AccelNode">
                        <StackPanel Spacing="6" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBox Text="{Binding Link}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding CopyLinkCommand}" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="复制链接" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDownloadNow" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="立即下载" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 关闭按钮（靠右） -->
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="OnClose"
                    Padding="20,6" />
        </StackPanel>
    </ScrollViewer>
</Window>
