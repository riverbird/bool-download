<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BoolDownload.Views.AboutDialog"
        Title="{DynamicResource Loc_Title_About}"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource DialogBackgroundBrush}">
    <StackPanel Margin="24,20" Spacing="16">
        <!-- Logo + 软件名称 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Image Source="/Assets/Icon.png" Width="56" Height="56" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="BoolDownload" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Classes="caption" />
            </StackPanel>
        </StackPanel>

        <TabControl>
            <!-- 软件信息 / 第三方库 / 系统运行环境 -->
            <TabItem Header="{DynamicResource Loc_About_SoftwareInfo}">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,0" Spacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Loc_About_SoftwareInfo}" />
                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBlock Grid.Row="0" Classes="caption" Text="{DynamicResource Loc_About_Product}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="BoolDownload" FontSize="13" />
                                <TextBlock Grid.Row="1" Classes="caption" Text="{DynamicResource Loc_About_Version}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SoftwareVersionText" FontSize="13" />
                                <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource Loc_About_Copyright}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CopyrightText" FontSize="13" />
                                <TextBlock Grid.Row="3" Classes="caption" Text="{DynamicResource Loc_About_License}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseText" FontSize="13" />
                                <TextBlock Grid.Row="4" Classes="caption" Text="{DynamicResource Loc_About_Engine}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="EngineText" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <!-- 第三方库及版本 -->
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Loc_About_ThirdParty}" />
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBlock Grid.Row="0" Classes="caption" Text="Avalonia" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AvaloniaVersionText" FontSize="13" />
                                <TextBlock Grid.Row="1" Classes="caption" Text="Xunlei.Open.DlSdk" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="XunleiSdkVersionText" FontSize="13" />
                                <TextBlock Grid.Row="2" Classes="caption" Text="Downloader" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DownloaderVersionText" FontSize="13" />
                                <TextBlock Grid.Row="3" Classes="caption" Text="MonoTorrent" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MonoTorrentVersionText" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <StackPanel Spacing="6">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Loc_About_System}" />
                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBlock Grid.Row="0" Classes="caption" Text="{DynamicResource Loc_About_Os}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsText" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Classes="caption" Text="{DynamicResource Loc_About_Runtime}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource Loc_About_Arch}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ArchitectureText" FontSize="13" />
                                <TextBlock Grid.Row="3" Classes="caption" Text="{DynamicResource Loc_About_WorkDir}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BaseDirectoryText" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Release Note -->
            <TabItem Header="{DynamicResource Loc_About_UpdateLog}">
                <TextBox x:Name="ReleaseNoteText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="320"
                         Margin="0,10,0,0" />
            </TabItem>
        </TabControl>

        <Button Classes="accent"
                Content="{DynamicResource Loc_Btn_Ok}"
                IsDefault="True"
                MinWidth="100"
                HorizontalAlignment="Center"
                Click="OnOk" />
    </StackPanel>
</Window>
