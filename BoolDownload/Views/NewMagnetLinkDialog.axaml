<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoolDownload.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="BoolDownload.Views.NewMagnetLinkDialog"
        x:DataType="vm:NewMagnetLinkViewModel"
        Title="{DynamicResource Loc_Title_NewMagnet}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Design.DataContext>
        <vm:NewMagnetLinkViewModel />
    </Design.DataContext>

    <StackPanel Margin="24,20" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_Magnet}" />
            <TextBox Text="{Binding MagnetUrl}"
                     MinHeight="32"
                     PlaceholderText="magnet:?xt=urn:btih:..." />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_TaskName}" />
                <TextBox Text="{Binding FileName}" PlaceholderText="{DynamicResource Loc_Ph_AutoName}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_MaxConnections}" />
                <NumericUpDown Minimum="1" Maximum="300" Increment="1"
                               Value="{Binding MaxConnections}"
                               HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_SavePath}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedFolder}" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        MinWidth="0"
                        Click="OnBrowseFolder"
                        ToolTip.Tip="{DynamicResource Loc_Tip_ChooseSavePath}">
                    <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="16" />
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="secondary" IsCancel="True" Click="OnCancel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Btn_Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="accent" IsDefault="True" Click="OnOk">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Btn_Ok}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
