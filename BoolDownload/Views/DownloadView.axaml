<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BoolDownload.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             NavigationPage.HasBackButton="False"
             x:Name="Root"
             x:DataType="vm:DownloadViewModel"
             x:Class="BoolDownload.Views.DownloadView">
    <ContentPage.Header>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/Icon.png" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="BoolDownload"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ContentPage.Header>
    <Design.DataContext>
        <vm:DownloadViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="新建下载" Command="{Binding NewDownloadCommand}" />
                <MenuItem Header="新建磁力链接下载" Command="{Binding NewMagnetLinkCommand}" />
                <Separator />
                <MenuItem Header="退出" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="选项" Click="OnOptions" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- 左侧状态栏列表 -->
        <ListBox DockPanel.Dock="Left"
                 MinWidth="180"
                 ItemsSource="{Binding StatusItems}"
                 SelectedItem="{Binding SelectedStatus}"
                 BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:StatusItem">
                    <DockPanel Margin="16,8">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Count}"
                                   Foreground="Gray"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="{Binding Icon}"
                                           IconVariant="Regular"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Padding="8,3"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,1*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UploadSpeed}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowDown" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DownloadSpeed}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧区域 -->
        <Grid RowDefinitions="Auto,*">
            <!-- 工具栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8">
                <Button Command="{Binding NewDownloadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Add" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="新建下载" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewMagnetLinkCommand}"
                        ToolTip.Tip="新建磁力链接下载">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Link" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="磁力链接" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Height="24" Margin="8,0" VerticalAlignment="Center" />
                <Button Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Play" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="开始" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PauseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Pause" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="暂停" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="删除" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Height="24" Margin="8,0" VerticalAlignment="Center" />
                <Button Command="{Binding PropertiesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="属性" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 下载列表表格 -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      RowHeight="40"
                      CellPointerPressed="OnCellsPointerPressed"
                      VerticalScrollBarVisibility="Visible">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding DataContext, ElementName=Root}">
                        <MenuItem Header="删除" Command="{Binding MoveToTrashCommand}" />
                        <MenuItem Header="删除条目及文件" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="打开文件" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="打开保存文件夹" Command="{Binding OpenSaveFolderCommand}" />
                        <Separator />
                        <MenuItem Header="开始" Command="{Binding StartCommand}" />
                        <MenuItem Header="暂停" Command="{Binding PauseCommand}" />
                        <Separator />
                        <MenuItem Header="属性" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="完成" Binding="{Binding Done}" Width="120" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120" />
                    <DataGridTemplateColumn Header="进度(%)" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:DownloadItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="8,0" VerticalAlignment="Center" ColumnSpacing="8">
                                    <ProgressBar Grid.Column="0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Progress}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Progress, StringFormat={}{0:0.#}%}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="添加时间" Binding="{Binding AddedTime, StringFormat={}{0:MM-dd HH:mm}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</ContentPage>
