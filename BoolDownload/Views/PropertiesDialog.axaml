<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoolDownload.ViewModels"
        x:Class="BoolDownload.Views.PropertiesDialog"
        x:DataType="vm:PropertiesViewModel"
        Title="{DynamicResource Loc_Title_Properties}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Design.DataContext>
        <vm:PropertiesViewModel Url="https://example.com/file.zip"
                                FileName="file.zip"
                                SavePath="/home/user/Downloads"
                                MaxConnections="16" />
    </Design.DataContext>

    <StackPanel Margin="24,20" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_Url}" />
            <TextBox Text="{Binding Url}" IsReadOnly="True" TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_FileName}" />
                <TextBox Text="{Binding FileName}" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_MaxConnections}" />
                <TextBox Text="{Binding MaxConnections}" IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_SavePath}" />
            <TextBox Text="{Binding SavePath}" IsReadOnly="True" TextWrapping="Wrap" />
        </StackPanel>

        <Button Classes="accent"
                Content="{DynamicResource Loc_Btn_Ok}"
                IsDefault="True"
                HorizontalAlignment="Right"
                Click="OnOk" />
    </StackPanel>
</Window>
