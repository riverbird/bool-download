<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BoolDownload.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             NavigationPage.HasBackButton="False"
             x:DataType="vm:DownloadViewModel"
             x:Class="BoolDownload.Views.DownloadView">
    <ContentPage.Header>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/Icon.png" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="BoolDownload"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ContentPage.Header>
    <Design.DataContext>
        <vm:DownloadViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="新建下载" Command="{Binding NewDownloadCommand}" />
                <Separator />
                <MenuItem Header="退出" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="选项" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- 左侧状态栏列表 -->
        <ListBox DockPanel.Dock="Left"
                 MinWidth="180"
                 ItemsSource="{Binding StatusItems}"
                 SelectedItem="{Binding SelectedStatus}"
                 BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:StatusItem">
                    <DockPanel Margin="16,8">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Count}"
                                   Foreground="Gray"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 右侧区域 -->
        <Grid RowDefinitions="Auto,*">
            <!-- 工具栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8">
                <Button Content="创建新下载" Command="{Binding NewDownloadCommand}" />
                <Button Content="开始" Command="{Binding StartCommand}" />
                <Button Content="暂停" Command="{Binding PauseCommand}" />
                <Button Content="删除" Command="{Binding DeleteCommand}" />
                <Separator Width="1" Height="24" Margin="8,0" VerticalAlignment="Center" />
                <Button Content="属性" Command="{Binding PropertiesCommand}" />
            </StackPanel>

            <!-- 下载列表表格 -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      RowHeight="40"
                      VerticalScrollBarVisibility="Visible">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="完成" Binding="{Binding Done}" Width="120" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120" />
                    <DataGridTemplateColumn Header="进度(%)" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:DownloadItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="8,0" VerticalAlignment="Center" ColumnSpacing="8">
                                    <ProgressBar Grid.Column="0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Progress}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Progress, StringFormat={}{0:0.#}%}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="添加时间" Binding="{Binding AddedTime, StringFormat={}{0:MM-dd HH:mm}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</ContentPage>