<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="BoolDownload.Views.DeleteConfirmDialog"
        Title="删除下载任务"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="24" Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ic:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="32" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
                <TextBlock Text="确定要删除选中的下载任务吗？"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="删除后将同时删除该任务已下载的文件，且无法恢复。"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="确定" IsDefault="True" Click="OnOk" />
            <Button Content="取消" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
