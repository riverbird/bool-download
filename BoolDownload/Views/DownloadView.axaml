<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BoolDownload.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             NavigationPage.HasNavigationBar="False"
             x:Name="Root"
             x:DataType="vm:DownloadViewModel"
             x:Class="BoolDownload.Views.DownloadView">
    <Design.DataContext>
        <vm:DownloadViewModel />
    </Design.DataContext>

    <ContentPage.Styles>
        <!-- 左侧导航列表：Windows 11 NavigationView 风格 -->
        <Style Selector="ListBox.navlist">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="SelectionMode" Value="AlwaysSelected" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
        </Style>

        <!-- 选中时显示左侧强调色指示条 -->
        <Style Selector="ListBox.navlist ListBoxItem Border.SelectionIndicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.navlist ListBoxItem:selected Border.SelectionIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ContentPage.Styles>

    <DockPanel Background="{DynamicResource PageBackgroundBrush}">
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="Transparent">
            <MenuItem Header="{DynamicResource Loc_Menu_File}">
                <MenuItem Header="{DynamicResource Loc_Menu_NewDownload}" Command="{Binding NewDownloadCommand}" />
                <MenuItem Header="{DynamicResource Loc_Menu_NewMagnet}" Command="{Binding NewMagnetLinkCommand}" />
                <MenuItem Header="{DynamicResource Loc_Menu_OpenTorrent}" Command="{Binding NewTorrentCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Loc_Menu_Exit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Menu_Tools}">
                <MenuItem Header="{DynamicResource Loc_Menu_Options}" Click="OnOptions" />
                <MenuItem Header="{DynamicResource Loc_Menu_Accelerator}" Click="OnAccelerator" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Menu_Help}">
                <MenuItem Header="{DynamicResource Loc_Menu_About}" Click="OnAbout" />
                <MenuItem Header="{DynamicResource Loc_Menu_CheckUpdate}" Click="OnCheckUpdate" />
            </MenuItem>
        </Menu>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Height="32"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowUp"
                                   IconVariant="Regular"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UploadSpeed}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowDown"
                                   IconVariant="Regular"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DownloadSpeed}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="240,*">
            <!-- 左侧导航栏：pane header + 导航列表 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Pane header -->
                    <StackPanel Grid.Row="0" Margin="16,20,16,12" Spacing="2">
                        <TextBlock Text="{DynamicResource Loc_Pane_Title}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc_Pane_Subtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="StatusList"
                             Classes="navlist"
                             ItemsSource="{Binding StatusItems}"
                             SelectedItem="{Binding SelectedStatus}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:StatusItem">
                                <Grid ColumnDefinitions="3,Auto,*,Auto"
                                      Margin="4,0"
                                      AutomationProperties.Name="{Binding DisplayName}">
                                    <Border Grid.Column="0"
                                            Classes="SelectionIndicator"
                                            Width="3"
                                            Height="16"
                                            CornerRadius="1.5"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                    <ic:FluentIcon Grid.Column="1"
                                                   Icon="{Binding Icon}"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   Width="20"
                                                   Height="20"
                                                   Margin="13,0,13,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayName}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Count}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧内容区域 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- 工具栏：Windows 11 命令栏 -->
                <Border Grid.Row="0" Padding="24,12,24,4" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="accent"
                                Command="{Binding NewDownloadCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_NewDownload}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Add"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_NewDownload}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding NewMagnetLinkCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Magnet}"
                                ToolTip.Tip="{DynamicResource Loc_Tip_NewMagnet}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Link" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Magnet}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding NewTorrentCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Torrent}"
                                ToolTip.Tip="{DynamicResource Loc_Tip_NewTorrent}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Document" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Torrent}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1"
                                Height="20"
                                Margin="8,0"
                                Background="{DynamicResource DividerBrush}"
                                VerticalAlignment="Center" />
                        <Button Classes="tool"
                                Command="{Binding StartCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Start}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Play" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Start}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding PauseCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Pause}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Pause" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Pause}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Delete}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Delete" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Delete}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1"
                                Height="20"
                                Margin="8,0"
                                Background="{DynamicResource DividerBrush}"
                                VerticalAlignment="Center" />
                        <Button Classes="tool"
                                Command="{Binding PropertiesCommand}"
                                AutomationProperties.Name="{DynamicResource Loc_Tb_Properties}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Settings" IconVariant="Regular" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_Tb_Properties}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 下载列表：Windows 11 卡片容器 -->
                <Border Grid.Row="1"
                        Margin="24,12,24,24"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <DataGrid x:Name="DownloadGrid"
                              ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              RowHeight="40"
                              ColumnHeaderHeight="36"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                              CellPointerPressed="OnCellsPointerPressed"
                              VerticalScrollBarVisibility="Visible">
                        <DataGrid.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{DynamicResource Loc_Tb_Delete}" Command="{Binding MoveToTrashCommand}" />
                                <MenuItem Header="{DynamicResource Loc_Ctx_DeleteAndFiles}" Command="{Binding DeleteCommand}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Loc_Ctx_OpenFile}" Command="{Binding OpenFileCommand}" />
                                <MenuItem Header="{DynamicResource Loc_Ctx_OpenFolder}" Command="{Binding OpenSaveFolderCommand}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Loc_Tb_Start}" Command="{Binding StartCommand}" />
                                <MenuItem Header="{DynamicResource Loc_Tb_Pause}" Command="{Binding PauseCommand}" />
                                <MenuItem Header="{DynamicResource Loc_Ctx_Redownload}" Command="{Binding RedownloadCommand}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Loc_Ctx_CopyLink}" Command="{Binding CopyLinkCommand}" />
                                <MenuItem Header="{DynamicResource Loc_Tb_Properties}" Command="{Binding PropertiesCommand}" />
                            </MenuFlyout>
                        </DataGrid.ContextFlyout>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_Status}" Binding="{Binding StatusLabel}" Width="110" />
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_Name}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_Done}" Binding="{Binding Done}" Width="100" />
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_Size}" Binding="{Binding Size}" Width="100" />
                            <DataGridTemplateColumn Header="{DynamicResource Loc_Col_Progress}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:DownloadItem">
                                        <Grid ColumnDefinitions="*,Auto" Margin="12,0" VerticalAlignment="Center" ColumnSpacing="8">
                                            <ProgressBar Grid.Column="0"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Progress}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Progress, StringFormat={}{0:0.#}%}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_Speed}"
                                                Binding="{Binding Speed}"
                                                Width="110"
                                                IsVisible="False" />
                            <DataGridTextColumn Header="{DynamicResource Loc_Col_AddedTime}" Binding="{Binding AddedTime, StringFormat={}{0:MM-dd HH:mm}}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</ContentPage>
