<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoolDownload.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="BoolDownload.Views.AcceleratorDialog"
        x:DataType="vm:AcceleratorViewModel"
        Title="{DynamicResource Loc_Title_Accelerator}"
        Width="740"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Design.DataContext>
        <vm:AcceleratorViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Acc_Type}" />
                <ComboBox ItemsSource="{Binding AccelTypes}"
                          SelectedIndex="{Binding SelectedTypeIndex}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_Url}" />
                <TextBox Text="{Binding InputUrl}"
                         PlaceholderText="{DynamicResource Loc_Ph_AcceleratorUrl}" />
            </StackPanel>

            <Button Classes="accent"
                    Command="{Binding ConvertCommand}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Btn_Convert}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Text="{DynamicResource Loc_Field_Url}"
                       FontSize="15"
                       FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding Nodes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AccelNode">
                        <StackPanel Spacing="6" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       Classes="caption" />
                            <TextBox Text="{Binding Link}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary"
                                        MinWidth="0"
                                        Height="32"
                                        Padding="12,0"
                                        Command="{Binding CopyLinkCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:FluentIcon Icon="Copy" IconVariant="Regular" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc_Btn_Copy}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary"
                                        MinWidth="0"
                                        Height="32"
                                        Padding="12,0"
                                        Click="OnDownloadNow">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:FluentIcon Icon="ArrowDownload" IconVariant="Regular" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc_Btn_Download}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="secondary"
                    Content="{DynamicResource Loc_Btn_Close}"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="OnClose" />
        </StackPanel>
    </ScrollViewer>
</Window>
