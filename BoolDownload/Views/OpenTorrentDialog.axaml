<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoolDownload.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="BoolDownload.Views.OpenTorrentDialog"
        x:DataType="vm:TorrentInfoViewModel"
        Title="{DynamicResource Loc_Title_Torrent}"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Design.DataContext>
        <vm:TorrentInfoViewModel />
    </Design.DataContext>

    <StackPanel Margin="24,20" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_TorrentFile}" />
            <TextBox Text="{Binding FilePath}" IsReadOnly="True" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="2">
            <TextBlock Text="{Binding TorrentName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Info_Files}" />
        </StackPanel>

        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Files}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MaxHeight="240"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Loc_Col_Path}" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Loc_Col_Size}" Binding="{Binding SizeText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_SavePath}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedFolder}" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        MinWidth="0"
                        Click="OnBrowseFolder"
                        ToolTip.Tip="{DynamicResource Loc_Tip_ChooseSavePath}">
                    <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="16" />
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{DynamicResource Loc_Field_MaxConnections}" />
            <NumericUpDown Minimum="1" Maximum="300" Increment="1"
                           Value="{Binding MaxConnections}"
                           HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="secondary" IsCancel="True" Click="OnCancel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Btn_Cancel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="accent" IsDefault="True" Click="OnOk">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Btn_Ok}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
